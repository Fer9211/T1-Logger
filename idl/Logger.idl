module T1Logger {
    enum Severidade {
        DEBUG,
        WARNING,
        ERROR,
        CRITICAL
    };

    exception EventNotFound {
        string mensagem;
    };

    interface Logger {
        // registra eventos (dos clientes)
        oneway void log(
            in Severidade severidade,
            in string endereco,
            in unsigned short pid,
            in long hora,
            in string msg
        );

        // consulta endereço do último evento
        string locate(in Severidade severidade) raises (EventNotFound);
    };
};